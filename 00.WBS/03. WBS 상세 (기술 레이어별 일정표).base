filters:
  and:
    - file.inFolder("00.WBS/03. WBS 작업")
views:
  - type: table
    name: 전체 (일정순)
    order:
      - 구분
      - 역할분류
      - file.name
      - 담당자
      - 완료여부
      - 시작일
      - 종료일
    sort:
      - property: 시작일
        direction: ASC
  - type: table
    name: 미완료만
    filters:
      and:
        - 완료여부 != "완료"
    order:
      - 구분
      - file.name
      - 담당자
      - 완료여부
      - 종료일
    sort:
      - property: 종료일
        direction: ASC
