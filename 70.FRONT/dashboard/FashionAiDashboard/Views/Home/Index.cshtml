@model FashionAiDashboard.Models.HomeStatsViewModel
@{
    ViewData["Title"] = "홈";
}

<h1 class="page-title">홈</h1>

<div class="stat-row">
    @foreach (var card in Model.KpiCards)
    {
        <div class="stat-card">
            <div class="stat-card-label">@card.Label</div>
            <div class="stat-card-value tone-@card.Tone">
                <span>@card.Value</span>
                @if (!string.IsNullOrEmpty(card.Unit))
                {
                    <span class="stat-card-unit">@card.Unit</span>
                }
            </div>
            @if (!string.IsNullOrEmpty(card.Caption))
            {
                <div class="stat-card-caption">@card.Caption</div>
            }
        </div>
    }
</div>

<div class="widget-card">
    <h2 class="widget-card-title">위젯 영역 (준비중)</h2>
    <p class="placeholder-note">
        원래 React 버전엔 베스트셀러·재고 위험·예측 미니 위젯 등 17종이 카드형으로 배치돼 있었습니다.
        데이터 연동 방식(Dataverse Web API 직접 호출 vs 별도 C# 백엔드)이 정해지는 대로 위젯을 하나씩 이식할 예정입니다.
    </p>
</div>
